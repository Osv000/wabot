<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> · Bot Console</title>
  <link rel="stylesheet" href="/static/style.css" />
</head>
<body>
<div class="topbar">
  <div class="brand"><span class="dot <%= connected ? 'on' : '' %>"></span> WA Bot Console</div>
  <% if (typeof loggedIn !== 'undefined' && loggedIn) { %>
    <a href="/logout" class="btn btn-outline" style="text-decoration:none; padding:8px 16px; font-family: var(--mono); font-size:12px; border:1px solid var(--panel-line); border-radius:6px;">Log out</a>
  <% } %>
</div>
<div class="shell">
  <nav class="sidenav">
    <a href="/dashboard" class="<%= active === 'overview' ? 'active' : '' %>">Overview</a>
    <a href="/dashboard/chats" class="<%= active === 'chats' ? 'active' : '' %>">Chats</a>
    <a href="/dashboard/viewonce" class="<%= active === 'viewonce' ? 'active' : '' %>">View Once</a>
    <a href="/dashboard/send" class="<%= active === 'send' ? 'active' : '' %>">Send Message</a>
    <a href="/" class="<%= active === 'link' ? 'active' : '' %>">Link / Device</a>
  </nav>
  <main class="main">
