# ---- Server ----
PORT=3000
SESSION_SECRET=change-this-to-a-long-random-string

# ---- Admin dashboard login ----
# Generate ADMIN_PASSWORD_HASH by running: npm run create-admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# ---- Bot behaviour ----
# Command prefix used in chats, e.g. "!ai hello"
COMMAND_PREFIX=!
# Your own WhatsApp number in international format, no + or spaces, e.g. 2348012345678
# Only this number can use admin-only commands (like remote control from your own chat).
OWNER_NUMBER=

# When a view-once photo/video comes in, automatically forward a copy to your
# own personal chat (OWNER_NUMBER) on WhatsApp, in addition to saving it to disk.
AUTO_FORWARD_VIEWONCE=true

# ---- AI provider ----
# Pick one provider and set its key. Leave both blank to disable the !ai command.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---- Storage ----
DATA_DIR=./data
